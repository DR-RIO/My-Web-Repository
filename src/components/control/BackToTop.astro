---
import FloatingButton from "@components/common/FloatingButton.astro";
---

<FloatingButton
	id="back-to-top-btn"
	icon="material-symbols:keyboard-arrow-up-rounded"
	ariaLabel="Back to Top"
	onclick="backToTop()"
	class="hide"
/>

<script is:raw is:inline>
	function backToTop() {
		window.scroll({ top: 0, behavior: "smooth" });
	}

	// 禁用此处的 BackToTopManager，避免与 back-to-top-handler.ts 中的 BackToTopHandler 冲突
	// 返回顶部按钮的显示/隐藏逻辑已由 back-to-top-handler.ts 统一处理
</script>
