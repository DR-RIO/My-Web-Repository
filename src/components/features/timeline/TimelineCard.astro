---
import { Icon } from "astro-icon/components";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import type { TimelineCardProps } from "./types";

const { item, maxSkills } = Astro.props as TimelineCardProps;

const isCurrent = !item.endDate;

const getTypeIcon = (type: string) => {
	switch (type) {
		case "education":
			return "material-symbols:school";
		case "work":
			return "material-symbols:work";
		case "project":
			return "material-symbols:code";
		case "achievement":
			return "material-symbols:emoji-events";
		default:
			return "material-symbols:event";
	}
};

const getTypeText = (type: string) => {
	switch (type) {
		case "education":
			return i18n(I18nKey.timelineEducation);
		case "work":
			return i18n(I18nKey.timelineWork);
		case "project":
			return i18n(I18nKey.timelineProject);
		case "achievement":
			return i18n(I18nKey.timelineAchievement);
		default:
			return type;
	}
};

const getLinkIcon = (type: string) => {
	switch (type) {
		case "certificate":
			return "material-symbols:verified";
		case "project":
			return "material-symbols:open-in-new";
		case "website":
			return "material-symbols:language";
		default:
			return "material-symbols:description";
	}
};

const formatDate = (dateString: string) => {
	const date = new Date(dateString);
	return date.toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "short",
	});
};

const getDuration = (startDate: string, endDate?: string) => {
	const start = new Date(startDate);
	const end = endDate ? new Date(endDate) : new Date();
	const diffTime = Math.abs(end.getTime() - start.getTime());
	const diffMonths = Math.ceil(diffTime / (1000 * 60 * 60 * 24 * 30));

	if (diffMonths < 12) {
		return `${diffMonths} ${i18n(I18nKey.timelineMonths)}`;
	}
	const years = Math.floor(diffMonths / 12);
	const months = diffMonths % 12;
	if (months === 0) {
		return `${years} ${i18n(I18nKey.timelineYears)}`;
	}
	return `${years} ${i18n(I18nKey.timelineYears)} ${months} ${i18n(I18nKey.timelineMonths)}`;
};

const icon = item.icon || getTypeIcon(item.type);
const typeText = getTypeText(item.type);
const dateRange = `${formatDate(item.startDate)} - ${item.endDate ? formatDate(item.endDate) : i18n(I18nKey.timelinePresent)}`;
const duration = getDuration(item.startDate, item.endDate);
const nodeColor = isCurrent ? "#22c55e" : item.color || "var(--primary)";
const hasLinks = item.links && item.links.length > 0;

const displaySkills =
	maxSkills && item.skills ? item.skills.slice(0, maxSkills) : item.skills;
const remainingSkills =
	maxSkills && item.skills ? item.skills.length - maxSkills : 0;

const allImages: string[] = [];
if (item.image) allImages.push(item.image);
if (item.images) allImages.push(...item.images);
const hasImages = allImages.length > 0;
---

<div
	class:list={["timeline-entry", { "is-current": isCurrent }]}
	data-type={item.type}
>
	<div class="timeline-node" style={`background-color: ${nodeColor};`}>
		<Icon name={icon} class="w-2.5 h-2.5" style="color: white;" />
	</div>

	<div
		class="timeline-card group relative rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-all duration-300 hover:shadow-lg"
	>
		<div class="p-5 sm:p-6">
			<div class="flex items-start gap-3 mb-3">
				<div
					class="w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center bg-[var(--btn-regular-bg)]"
				>
					<Icon
						name={icon}
						class="text-lg"
						style={`color: ${item.color || "var(--primary)"};`}
					/>
				</div>

				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2 mb-0.5">
						<h3
							class="text-lg font-bold text-black/90 dark:text-white/90 group-hover:text-[var(--primary)] transition-colors duration-200"
						>
							{item.title}
						</h3>
						{
							item.featured && (
								<Icon
									name="material-symbols:star-rounded"
									class="text-base w-4 h-4 text-[var(--primary)] flex-shrink-0"
								/>
							)
						}
					</div>
					{
						item.organization && (
							<p class="text-sm text-black/60 dark:text-white/60">
								{item.organization}
								{item.position ? ` · ${item.position}` : ""}
							</p>
						)
					}
				</div>

				<div class="flex items-center gap-1.5 flex-shrink-0 ml-2">
					{
						isCurrent && (
							<span class="px-2 py-0.5 text-xs rounded-md bg-green-500/10 text-green-600 dark:text-green-400 font-medium">
								{i18n(I18nKey.timelineCurrent)}
							</span>
						)
					}
					<span
						class="px-2 py-0.5 text-xs rounded-md bg-[var(--primary)]/10 text-[var(--primary)] font-medium"
					>
						{typeText}
					</span>
				</div>
			</div>

			<p
				class="text-sm text-black/70 dark:text-white/70 mb-4 leading-relaxed"
			>
				{item.description}
			</p>

			{
				displaySkills && displaySkills.length > 0 && (
					<div class="flex flex-wrap gap-2 mb-4">
						{displaySkills.map((skill) => (
							<span class="px-2 py-1 text-xs rounded-md bg-[var(--primary)]/10 text-[var(--primary)] font-medium">
								{skill}
							</span>
						))}
						{remainingSkills > 0 && (
							<span class="px-2 py-1 text-xs rounded-md bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 font-medium">
								+{remainingSkills}
							</span>
						)}
					</div>
				)
			}

			{
				item.achievements && item.achievements.length > 0 && (
					<div class="mb-4">
						<h4 class="text-xs font-semibold text-black/50 dark:text-white/50 uppercase tracking-wider mb-2">
							{i18n(I18nKey.timelineAchievements)}
						</h4>
						<ul class="space-y-1.5">
							{item.achievements.map((achievement) => (
								<li class="text-sm text-black/70 dark:text-white/70 flex items-start gap-2">
									<Icon
										name="material-symbols:check-circle"
										class="text-base w-4 h-4 text-green-500 flex-shrink-0 mt-0.5"
									/>
									<span>{achievement}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<!-- 图片缩略图 -->
			{
				hasImages && (
					<div class="mb-4">
						{allImages.length === 1 && (
							<div
								class="timeline-thumb rounded-xl overflow-hidden border border-black/10 dark:border-white/10 cursor-pointer group/img"
								data-images={JSON.stringify(allImages)}
								data-index="0"
								data-alt={item.imageAlt || item.title}
							>
								<img
									src={allImages[0]}
									alt={item.imageAlt || item.title}
									class="w-full object-contain transition-transform duration-300 group-hover/img:scale-105"
									style={`max-height: ${item.imageHeight || "300px"};`}
									loading="lazy"
								/>
							</div>
						)}
						{allImages.length > 1 && (
							<div class="grid grid-cols-2 gap-3">
								{allImages.map((img, idx) => (
									<div
										class="timeline-thumb rounded-lg overflow-hidden border border-black/10 dark:border-white/10 cursor-pointer group/img"
										data-images={JSON.stringify(allImages)}
										data-index={String(idx)}
										data-alt={
											item.imageAlt ||
											`${item.title} - ${idx + 1}`
										}
									>
										<img
											src={img}
											alt={
												item.imageAlt ||
												`${item.title} - ${idx + 1}`
											}
											class="w-full object-contain transition-transform duration-300 group-hover/img:scale-105"
											style={`max-height: ${item.imageHeight || "200px"};`}
											loading="lazy"
										/>
									</div>
								))}
							</div>
						)}
					</div>
				)
			}

			<div
				class="flex items-center gap-4 text-xs text-black/50 dark:text-white/50 mb-1 pt-3 border-t border-black/5 dark:border-white/5"
			>
				<span class="flex items-center gap-1">
					<Icon
						name="material-symbols:calendar-month-outline"
						class="text-xs w-3.5 h-3.5"
					/>
					{dateRange}
				</span>
				<span class="flex items-center gap-1">
					<Icon
						name="material-symbols:schedule-outline"
						class="text-xs w-3.5 h-3.5"
					/>
					{duration}
				</span>
				{
					item.location && (
						<span class="flex items-center gap-1">
							<Icon
								name="material-symbols:location-on-outline"
								class="text-xs w-3.5 h-3.5"
							/>
							{item.location}
						</span>
					)
				}
			</div>

			{
				hasLinks && (
					<div class="flex flex-wrap gap-2 mt-3">
						{item.links!.map((link) => (
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="btn-regular flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium"
							>
								<Icon
									name={getLinkIcon(link.type)}
									class="text-xs w-3.5 h-3.5"
								/>
								{link.name}
							</a>
						))}
					</div>
				)
			}
		</div>

		<div
			class="absolute inset-0 bg-gradient-to-br from-[var(--primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-xl"
		>
		</div>
	</div>
</div>

<style>
	.timeline-entry {
		position: relative;
		padding-left: 2.5rem;
		padding-bottom: 2rem;
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	.timeline-entry:last-child {
		padding-bottom: 0;
	}

	.timeline-entry.filtered-out {
		display: none;
	}

	.timeline-node {
		position: absolute;
		left: 0;
		top: 1.5rem;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 50%;
		border: 2.5px solid white;
		box-shadow: 0 0 0 2px var(--line-divider);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.timeline-entry:hover .timeline-node {
		transform: scale(1.15);
		box-shadow:
			0 0 0 2px var(--primary),
			0 0 12px rgba(0, 0, 0, 0.1);
	}

	.timeline-entry.is-current .timeline-node {
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			box-shadow: 0 0 0 2px var(--line-divider);
		}
		50% {
			box-shadow:
				0 0 0 2px #22c55e,
				0 0 8px rgba(34, 197, 94, 0.3);
		}
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.timeline-entry:nth-child(1) {
		animation-delay: 0.05s;
	}
	.timeline-entry:nth-child(2) {
		animation-delay: 0.1s;
	}
	.timeline-entry:nth-child(3) {
		animation-delay: 0.15s;
	}
	.timeline-entry:nth-child(4) {
		animation-delay: 0.2s;
	}
	.timeline-entry:nth-child(5) {
		animation-delay: 0.25s;
	}
	.timeline-entry:nth-child(6) {
		animation-delay: 0.3s;
	}
	.timeline-entry:nth-child(7) {
		animation-delay: 0.35s;
	}
	.timeline-entry:nth-child(8) {
		animation-delay: 0.4s;
	}
	.timeline-entry:nth-child(9) {
		animation-delay: 0.45s;
	}
</style>

<script>
	function initImageViewer() {
		if (document.getElementById("global-image-viewer")) return;

		const viewer = document.createElement("div");
		viewer.id = "global-image-viewer";
		viewer.innerHTML = `
			<div class="gv-overlay">
				<div class="gv-toolbar">
					<span class="gv-counter"></span>
					<div class="gv-actions">
						<button class="gv-btn gv-zoom-in" title="放大">+</button>
						<button class="gv-btn gv-zoom-out" title="缩小">−</button>
						<button class="gv-btn gv-reset" title="重置">⊡</button>
						<button class="gv-btn gv-close" title="关闭">✕</button>
					</div>
				</div>
				<button class="gv-arrow gv-prev"></button>
				<button class="gv-arrow gv-next"></button>
				<div class="gv-container">
					<img class="gv-image" src="" alt="" draggable="false" />
				</div>
				<div class="gv-hint">滚轮缩放 · 拖拽移动 · ← → 切换 · Esc 关闭</div>
			</div>
		`;
		document.body.appendChild(viewer);

		const overlay = viewer.querySelector(".gv-overlay")!;
		const img = viewer.querySelector(".gv-image") as HTMLImageElement;
		const container = viewer.querySelector(".gv-container") as HTMLElement;
		const counter = viewer.querySelector(".gv-counter")!;
		const prevBtn = viewer.querySelector(".gv-prev")!;
		const nextBtn = viewer.querySelector(".gv-next")!;

		let images: string[] = [];
		let currentIndex = 0;
		let scale = 1;
		let translateX = 0;
		let translateY = 0;
		let isDragging = false;
		let dragStartX = 0;
		let dragStartY = 0;
		let startTranslateX = 0;
		let startTranslateY = 0;
		let initialPinchDistance = 0;
		let initialScale = 1;
		let initialPinchTranslateX = 0;
		let initialPinchTranslateY = 0;
		let pinchCenterX = 0;
		let pinchCenterY = 0;

		function applyTransform() {
			img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
		}

		function resetTransform() {
			scale = 1;
			translateX = 0;
			translateY = 0;
			applyTransform();
		}

		function updateImage() {
			img.src = images[currentIndex];
			counter.textContent = `${currentIndex + 1} / ${images.length}`;
			resetTransform();
			if (images.length <= 1) {
				prevBtn.classList.add("hidden");
				nextBtn.classList.add("hidden");
			} else {
				prevBtn.classList.remove("hidden");
				nextBtn.classList.remove("hidden");
			}
		}

		function open(imageList: string[], index: number) {
			images = imageList;
			currentIndex = index;
			viewer.classList.add("active");
			document.body.style.overflow = "hidden";
			updateImage();
		}

		function close() {
			viewer.classList.remove("active");
			document.body.style.overflow = "";
			resetTransform();
		}

		function getTouchDistance(touches: TouchList): number {
			const dx = touches[0].clientX - touches[1].clientX;
			const dy = touches[0].clientY - touches[1].clientY;
			return Math.sqrt(dx * dx + dy * dy);
		}

		function getTouchCenter(touches: TouchList): { x: number; y: number } {
			return {
				x: (touches[0].clientX + touches[1].clientX) / 2,
				y: (touches[0].clientY + touches[1].clientY) / 2,
			};
		}

		document.querySelectorAll(".timeline-thumb").forEach((el) => {
			el.addEventListener("click", (e) => {
				e.stopPropagation();
				const target = e.currentTarget as HTMLElement;
				const imgs = JSON.parse(target.dataset.images || "[]");
				const idx = parseInt(target.dataset.index || "0");
				open(imgs, idx);
			});
		});

		// 点击空白关闭
		viewer.addEventListener("click", (e) => {
			const target = e.target as HTMLElement;
			if (target === viewer || target === overlay) close();
		});

		viewer.querySelector(".gv-close")!.addEventListener("click", close);

		viewer.querySelector(".gv-zoom-in")!.addEventListener("click", () => {
			scale = Math.min(scale + 0.25, 5);
			applyTransform();
		});
		viewer.querySelector(".gv-zoom-out")!.addEventListener("click", () => {
			scale = Math.max(scale - 0.25, 0.25);
			applyTransform();
		});
		viewer
			.querySelector(".gv-reset")!
			.addEventListener("click", resetTransform);

		container.addEventListener("wheel", (e) => {
			e.preventDefault();
			scale = Math.max(
				0.25,
				Math.min(5, scale - (e as WheelEvent).deltaY * 0.005),
			);
			applyTransform();
		});

		container.addEventListener("mousedown", (e) => {
			e.preventDefault();
			isDragging = true;
			const me = e as MouseEvent;
			dragStartX = me.clientX;
			dragStartY = me.clientY;
			startTranslateX = translateX;
			startTranslateY = translateY;
			container.style.cursor = "grabbing";
		});

		window.addEventListener("mousemove", (e) => {
			if (!isDragging) return;
			const me = e as MouseEvent;
			translateX = startTranslateX + (me.clientX - dragStartX);
			translateY = startTranslateY + (me.clientY - dragStartY);
			applyTransform();
		});

		window.addEventListener("mouseup", () => {
			isDragging = false;
			container.style.cursor = "grab";
		});

		// 触摸事件：单指拖拽 + 双指缩放
		container.addEventListener(
			"touchstart",
			(e) => {
				const te = e as TouchEvent;
				if (te.touches.length === 1) {
					isDragging = true;
					dragStartX = te.touches[0].clientX;
					dragStartY = te.touches[0].clientY;
					startTranslateX = translateX;
					startTranslateY = translateY;
				} else if (te.touches.length === 2) {
					isDragging = false;
					initialPinchDistance = getTouchDistance(te.touches);
					initialScale = scale;
					initialPinchTranslateX = translateX;
					initialPinchTranslateY = translateY;
					const center = getTouchCenter(te.touches);
					pinchCenterX = center.x;
					pinchCenterY = center.y;
				}
			},
			{ passive: false },
		);

		container.addEventListener(
			"touchmove",
			(e) => {
				const te = e as TouchEvent;
				if (te.touches.length === 1 && isDragging) {
					e.preventDefault();
					translateX =
						startTranslateX + (te.touches[0].clientX - dragStartX);
					translateY =
						startTranslateY + (te.touches[0].clientY - dragStartY);
					applyTransform();
				} else if (te.touches.length === 2) {
					e.preventDefault();
					const newDistance = getTouchDistance(te.touches);
					const newScale = Math.max(
						0.25,
						Math.min(
							5,
							initialScale * (newDistance / initialPinchDistance),
						),
					);
					const center = getTouchCenter(te.touches);
					const scaleRatio = newScale / initialScale;
					translateX =
						center.x -
						scaleRatio * (pinchCenterX - initialPinchTranslateX);
					translateY =
						center.y -
						scaleRatio * (pinchCenterY - initialPinchTranslateY);
					scale = newScale;
					applyTransform();
				}
			},
			{ passive: false },
		);

		container.addEventListener("touchend", () => {
			isDragging = false;
		});

		prevBtn.addEventListener("click", (e) => {
			e.stopPropagation();
			currentIndex = (currentIndex - 1 + images.length) % images.length;
			updateImage();
		});
		nextBtn.addEventListener("click", (e) => {
			e.stopPropagation();
			currentIndex = (currentIndex + 1) % images.length;
			updateImage();
		});

		document.addEventListener("keydown", (e) => {
			if (!viewer.classList.contains("active")) return;
			switch (e.key) {
				case "Escape":
					close();
					break;
				case "ArrowLeft":
					currentIndex =
						(currentIndex - 1 + images.length) % images.length;
					updateImage();
					break;
				case "ArrowRight":
					currentIndex = (currentIndex + 1) % images.length;
					updateImage();
					break;
				case "+":
				case "=":
					scale = Math.min(scale + 0.25, 5);
					applyTransform();
					break;
				case "-":
					scale = Math.max(scale - 0.25, 0.25);
					applyTransform();
					break;
				case "0":
					resetTransform();
					break;
			}
		});
	}

	if (!document.getElementById("gv-styles")) {
		const style = document.createElement("style");
		style.id = "gv-styles";
		style.textContent = `
			#global-image-viewer { display: none; }
			#global-image-viewer.active { display: block; }

			.gv-overlay {
				position: fixed; inset: 0; z-index: 99999;
				background: rgba(0,0,0,0.5); display: flex;
				align-items: center; justify-content: center;
				animation: gvFadeIn 0.25s ease; user-select: none;
			}

			@keyframes gvFadeIn { from { opacity: 0; } to { opacity: 1; } }

			.gv-toolbar {
				position: fixed; top: 0; left: 0; right: 0; z-index: 100000;
				display: flex; align-items: center; justify-content: space-between;
				padding: 16px 20px;
				background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
			}
			.gv-counter { color: #fff; font-size: 14px; font-weight: 500; }
			.gv-actions { display: flex; gap: 6px; }
			.gv-btn {
				width: 42px; height: 42px; border: none; border-radius: 10px;
				background: rgba(255,255,255,0.1); color: #fff;
				font-size: 18px; cursor: pointer;
				display: flex; align-items: center; justify-content: center;
				transition: all 0.2s; backdrop-filter: blur(10px);
			}
			.gv-btn:hover { background: rgba(255,255,255,0.25); transform: scale(1.05); }

			.gv-arrow {
				position: fixed; top: 50%; transform: translateY(-50%); z-index: 100000;
				width: 50px; height: 50px; border: none; border-radius: 50%;
				background: rgba(255,255,255,0.1); color: #fff;
				font-size: 0; cursor: pointer;
				display: flex; align-items: center; justify-content: center;
				transition: all 0.2s; backdrop-filter: blur(10px);
			}
			.gv-arrow::before {
				content: '';
				display: block;
				width: 12px;
				height: 12px;
				border-top: 2px solid #fff;
				border-right: 2px solid #fff;
			}
			.gv-prev::before { transform: rotate(-135deg); margin-left: 4px; }
			.gv-next::before { transform: rotate(45deg); margin-right: 4px; }
			.gv-arrow:hover { background: rgba(255,255,255,0.25); transform: translateY(-50%) scale(1.1); }
			.gv-prev { left: 20px; }
			.gv-next { right: 20px; }
			.gv-arrow.hidden { display: none; }

			.gv-container {
				position: fixed; inset: 0; display: flex;
				align-items: center; justify-content: center; cursor: grab;
			}
			.gv-container:active { cursor: grabbing; }
			.gv-image {
				position: absolute; max-width: 100vw; max-height: 100vh;
				object-fit: contain; transition: transform 0.1s ease; pointer-events: none;
			}

			.gv-hint {
				position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
				color: rgba(255,255,255,0.4); font-size: 12px; z-index: 100000;
				background: rgba(0,0,0,0.3); padding: 6px 16px; border-radius: 20px;
				backdrop-filter: blur(10px);
			}

			@media (max-width: 640px) {
				.gv-arrow { width: 40px; height: 40px; }
				.gv-prev { left: 10px; } .gv-next { right: 10px; }
				.gv-hint { display: none; }
				.gv-toolbar { padding: 12px 14px; }
				.gv-btn { width: 38px; height: 38px; }
			}
		`;
		document.head.appendChild(style);
	}

	initImageViewer();
	document.addEventListener("astro:page-load", initImageViewer);
</script>
