---
import { formatRelativeTime, formatElegantDate } from "../../../utils/timeFormat";
import { linkifyContent } from "../../../utils/content-utils";
import { Icon } from "astro-icon/components";
import { profileConfig, commentConfig } from "../../../config";

interface Props {
	moment: {
		id: number;
		content: string;
		date: string;
		images?: string[];
		location?: string;
		mood?: string;
		tags?: string[];
		pinned?: boolean;
	};
	index: number;
	momentId: number;
	minutesAgo: string;
	hoursAgo: string;
	hourAgo?: string;
	daysAgo: string;
}

const { moment, index, momentId, minutesAgo, hoursAgo, daysAgo } = Astro.props;

const relativeTime = formatRelativeTime(
	moment.date,
	minutesAgo,
	hoursAgo,
	daysAgo,
);

const elegantDate = formatElegantDate(moment.date);
const contentWithLinks = linkifyContent(moment.content);

// ✅ 过滤空图片
const validImages = moment.images?.filter(Boolean) || [];
const twikooEnvId = commentConfig.twikoo?.envId || "";
---

<div
	class="moment-item card-base-daily p-4 md:p-6 lg:p-8 hover:shadow-lg transition-all"
	data-index={index}
>
	<!-- 头像和名字 -->
	<div class="moment-header flex items-center gap-3 mb-4">
		<img
			src={profileConfig.avatar}
			alt={profileConfig.name}
			class="w-10 h-10 rounded-full object-cover flex-shrink-0"
		/>
		<div class="flex flex-col">
			<span class="font-semibold text-base text-90">{profileConfig.name}</span>
		</div>
	</div>

	<div class="moment-content">
		<p
			class="moment-text text-sm md:text-base lg:text-lg text-90 leading-relaxed mb-3 md:mb-4"
			set:html={contentWithLinks}
		></p>

		{validImages.length > 0 && (
			<div class="diary-images mb-3 md:mb-4">
				{validImages.map((image, imgIndex) => (
					<div class="image-item relative rounded-md overflow-hidden cursor-pointer hover:scale-105 transition-transform">
						<a
							href="javascript:void(0)"
							data-src={image}
							data-fancybox={`gallery-${index}-${imgIndex}`}
							class="block w-full h-full"
						>
							<img
								src={image}
								alt="diary moment image"
								loading="lazy"
							/>
						</a>
					</div>
				))}
			</div>
		)}
	</div>

	<hr
		class="moment-divider border-t border-[var(--line-divider)] my-3 md:my-4"
	/>

	<!-- ✅ footer：时间 + 地点 + 心情 + 标签 + 置顶标识 + 点赞按钮 -->
		<div class="moment-footer flex flex-wrap items-start mt-4">
			<!-- 左侧：时间 + 地点 + 心情 -->
			<div class="flex flex-wrap items-center gap-3 flex-shrink-0">
			<div
				class="moment-time flex items-center gap-1.5 text-75"
			>
				<i class="time-icon text-xs">🕐</i>
				<time datetime={moment.date} class="flex flex-row gap-1 items-center">
					<span class="text-[var(--content-main)] font-medium text-xs">{elegantDate}</span>
					<span class="text-xs">({relativeTime})</span>
				</time>
			</div>

			<!-- 地点 -->
			{moment.location && (
				<div class="moment-location flex items-center gap-1 text-75">
					<Icon
						name="material-symbols:location-on"
						class="text-xs w-3.5 h-3.5"
					/>
					<span class="text-xs">{moment.location}</span>
				</div>
			)}

			<!-- 心情 -->
			{moment.mood && (
				<div class="moment-mood flex items-center gap-1 text-75">
					<Icon
						name="material-symbols:sentiment-satisfied"
						class="text-xs w-3.5 h-3.5"
					/>
					<span class="text-xs">{moment.mood}</span>
				</div>
			)}
		</div>

		<!-- 右侧：标签 + 置顶 + 点赞按钮 -->
		<div class="flex flex-wrap items-center gap-2 ml-auto w-full sm:w-auto flex-shrink-0 justify-end">
			<!-- 标签 -->
			{moment.tags && moment.tags.length > 0 && (
				<div class="moment-tags flex flex-wrap gap-1">
					{moment.tags.map((tag) => (
						<span class="tag-item text-xs px-2 py-1 rounded-full bg-[var(--btn-plain-bg)] text-[var(--primary)]">
							#{tag}
						</span>
					))}
				</div>
			)}

			{moment.pinned && <div class="pin-inline">📌 置顶</div>}

			<!-- 点赞按钮 -->
			<button 
				class="like-btn flex items-center gap-1.5 text-75 hover:text-[var(--primary)] transition-colors"
			data-moment-id={momentId}
				data-env-id={twikooEnvId}
			>
				<!-- 未点赞图标 -->
				<span class="like-icon-outline">
					<Icon name="material-symbols:favorite-outline" class="w-4.5 h-4.5" />
				</span>
				<!-- 已点赞图标 -->
				<span class="like-icon-filled" style="display: none;">
					<Icon name="material-symbols:favorite" class="w-4.5 h-4.5" />
				</span>
				<span class="like-count text-xs">0</span>
			</button>
		</div>
	</div>
</div>

<style>
	.card-base-daily {
		border-radius: var(--radius-large);
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		transition: all 0.3s ease;
	}

	/* 头像悬停效果 */
	.moment-header img {
		transition: transform 0.3s ease;
	}
	.moment-header img:hover {
		transform: scale(1.1);
	}

	/* 点赞按钮效果 */
	.like-btn {
		background: none;
		border: none;
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		transition: all 0.2s ease;
	}
	
	.like-btn:hover {
		background: rgba(255, 71, 87, 0.1);
	}

	.like-btn:active {
		transform: scale(0.95);
	}

	.like-btn.liked {
		color: #ff4757 !important;
		background: rgba(255, 71, 87, 0.15);
	}

	.like-btn:disabled {
		/* 禁用时保持视觉一致，只通过程序防止重复点击 */
		pointer-events: none;
	}

	.like-btn .like-icon-outline,
	.like-btn .like-icon-filled,
	.like-btn .like-count {
		transition: transform 0.3s ease, opacity 0.15s ease;
		display: inline-flex;
		align-items: center;
	}

	.like-btn.liked .like-icon-filled {
		animation: heartBeat 0.6s ease-in-out;
	}

	@keyframes heartBeat {
		0% { transform: scale(1); }
		25% { transform: scale(1.3); }
		50% { transform: scale(0.9); }
		75% { transform: scale(1.1); }
		100% { transform: scale(1); }
	}

	/* ⭐ 置顶标识（右侧） */
	.pin-inline {
		font-size: 12px;
		color: #f59e0b;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 4px;
		background: rgba(245, 158, 11, 0.1);
		padding: 2px 8px;
		border-radius: 999px;
	}

	/* ⭐ 可选：让置顶卡片微高亮 */
	.card-base-daily:has(.pin-inline) {
		border-color: #f59e0b;
	}

	/* ⭐ 标签样式 */
	.tag-item {
		font-weight: 500;
		transition: all 0.2s ease;
		cursor: pointer;
	}
	.tag-item:hover {
		background: var(--btn-plain-bg-hover);
		transform: translateY(-1px);
	}

	/* ⭐ 地点和心情样式 */
	.moment-location,
	.moment-mood {
		transition: color 0.2s ease;
	}
	.moment-location:hover,
	.moment-mood:hover {
		color: var(--content-main);
	}

	.image-item img {
		transition: transform 0.3s ease;
	}
	.image-item:hover img {
		transform: scale(1.05);
	}
	.moment-text {
		white-space: pre-line;
	}

	/* ========== 移动端优化 ========== */
	@media (max-width: 768px) {
		.card-base-daily {
			border-radius: var(--radius-large);
		}

		.moment-header {
			margin-bottom: 0.75rem !important;
		}

		.moment-header img {
			width: 36px !important;
			height: 36px !important;
		}

		.moment-text {
			font-size: 0.875rem !important;
			line-height: 1.6 !important;
			word-wrap: break-word;
			overflow-wrap: break-word;
		}

		.diary-images {
			gap: 0.5rem !important;
			margin-bottom: 0.75rem !important;
		}

		.image-item {
			border-radius: 0.5rem !important;
		}

		.moment-divider {
			margin: 0.5rem 0 !important;
		}

		.moment-footer {
			margin-top: 0.75rem !important;
			gap: 0.5rem !important;
		}

		.pin-inline {
			font-size: 0.7rem !important;
			padding: 1px 6px !important;
		}

		.tag-item {
			font-size: 0.7rem !important;
			padding: 2px 6px !important;
		}

		.like-btn {
			padding: 0.25rem 0.5rem !important;
			gap: 0.25rem !important;
		}

		.like-count {
			font-size: 0.75rem !important;
		}
	}

	/* 超小屏幕（如 iPhone SE）优化 */
	@media (max-width: 480px) {
		.card-base-daily {
			padding: 0.75rem !important;
		}

		.moment-text {
			font-size: 0.8125rem !important;
		}

		.diary-images {
			gap: 0.375rem !important;
		}

		/* 单张图片：适中大小，保持原始比例 */
		.diary-images:not(:has(.image-item:nth-child(2))) .image-item {
			max-width: 220px !important;
		}

		/* 2张图片 */
		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) {
			gap: 0.375rem !important;
		}

		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) .image-item {
			max-width: 140px !important;
		}

		/* 3张及以上图片 */
		.diary-images:has(.image-item:nth-child(3)) {
			gap: 0.375rem !important;
		}
	}

	/* 图片容器和图片优化 - 基础样式（应用于所有宽度） */
	.diary-images {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	/* 基础：2张图片 */
	.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	/* 基础：3张及以上图片 */
	.diary-images:has(.image-item:nth-child(3)) {
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}

	/* 单张图片：保持原始比例，不截断 */
	.diary-images:not(:has(.image-item:nth-child(2))) .image-item {
		max-width: 400px;
		overflow: hidden;
		position: relative;
	}

	.diary-images:not(:has(.image-item:nth-child(2))) .image-item img {
		width: 100%;
		height: auto;
		object-fit: contain;
		display: block;
	}

	/* 2张及以上图片：保持正方形，使用 cover 裁剪 */
	.diary-images:has(.image-item:nth-child(2)) .image-item {
		aspect-ratio: 1;
		overflow: hidden;
		position: relative;
	}

	.diary-images:has(.image-item:nth-child(2)) .image-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* 平板端 (768px - 1280px) 优化 */
	@media (min-width: 768px) and (max-width: 1279px) {
		.diary-images {
			gap: 0.75rem;
		}

		/* 单张图片：适中大小 */
		.diary-images:not(:has(.image-item:nth-child(2))) .image-item {
			max-width: 350px;
		}

		/* 2张图片 */
		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) {
			gap: 0.75rem;
		}

		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) .image-item {
			max-width: 180px;
		}

		/* 3张及以上图片 */
		.diary-images:has(.image-item:nth-child(3)) {
			gap: 0.75rem;
		}
	}

	/* 桌面端 (1280px+) 优化 */
	@media (min-width: 1280px) {
		.diary-images {
			gap: 1rem;
		}

		/* 单张图片：合适大小 */
		.diary-images:not(:has(.image-item:nth-child(2))) .image-item {
			max-width: 400px;
		}

		/* 2张图片 */
		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) {
			gap: 1rem;
		}

		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) .image-item {
			max-width: 220px;
		}

		/* 3张及以上图片 */
		.diary-images:has(.image-item:nth-child(3)) {
			gap: 1rem;
		}
	}

	/* 横屏移动端优化 */
	@media (max-width: 768px) and (orientation: landscape) {
		.diary-images {
			gap: 0.375rem !important;
		}

		/* 单张图片 */
		.diary-images:not(:has(.image-item:nth-child(2))) .image-item {
			max-width: 200px !important;
		}

		/* 2张图片 */
		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) .image-item {
			max-width: 150px !important;
		}
	}

	/* 确保单张图片在移动端也能很好地展示 */
	@media (max-width: 768px) {
		.diary-images {
			max-width: 100%;
			gap: 0.5rem;
		}

		/* 单张图片：适中大小，保持原始比例 */
		.diary-images:not(:has(.image-item:nth-child(2))) .image-item {
			max-width: 260px;
		}

		/* 2张图片 */
		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) {
			gap: 0.5rem;
		}

		.diary-images:has(.image-item:nth-child(2)):not(:has(.image-item:nth-child(3))) .image-item {
			max-width: 160px;
		}

		/* 3张及以上图片 */
		.diary-images:has(.image-item:nth-child(3)) {
			gap: 0.5rem;
		}
	}

	/* 针对触摸设备的优化 */
	@media (hover: none) and (pointer: coarse) {
		.image-item {
			-webkit-tap-highlight-color: transparent;
		}

		.image-item:active img {
			transform: scale(0.98);
			transition: transform 0.1s ease;
		}
	}
</style>

<script is:inline define:vars={{twikooEnvId}}>
	// 点赞功能 - 使用 Waline SDK + WebSocket 实现实时推送
	const STORAGE_KEY_PREFIX = 'diary_liked_';

	// ✅ 配置你的 Waline 服务器地址！
	const WALINE_SERVER_URL = 'https://waline.isu183s.top';

	// Waline SDK 实例（用于 WebSocket 实时推送）
	let walineInstance = null;

	// 生成日记的唯一ID
	function getDiaryId(momentId) {
		return `diary_${momentId}`;
	}

	// 获取日记的点赞 URL（用于 Waline）
	function getLikeUrl(momentId) {
		return `/diary/${getDiaryId(momentId)}`;
	}

	// 检查当前用户是否已经点赞（本地存储）
	function hasLiked(momentId) {
		return localStorage.getItem(STORAGE_KEY_PREFIX + getDiaryId(momentId)) === 'true';
	}

	// 保存点赞状态到本地
	function setLiked(momentId, liked) {
		if (liked) {
			localStorage.setItem(STORAGE_KEY_PREFIX + getDiaryId(momentId), 'true');
		} else {
			localStorage.removeItem(STORAGE_KEY_PREFIX + getDiaryId(momentId));
		}
	}

	// 更新按钮显示状态
	function updateButtonDisplay(btn, liked, count) {
		const iconOutline = btn.querySelector('.like-icon-outline');
		const iconFilled = btn.querySelector('.like-icon-filled');
		const countEl = btn.querySelector('.like-count');

		if (liked) {
			btn.classList.add('liked');
			if (iconOutline) iconOutline.style.display = 'none';
			if (iconFilled) iconFilled.style.display = 'inline-flex';
		} else {
			btn.classList.remove('liked');
			if (iconOutline) iconOutline.style.display = 'inline-flex';
			if (iconFilled) iconFilled.style.display = 'none';
		}

		if (countEl) {
			countEl.textContent = count;
		}
	}

	// 从 Waline 获取点赞数
	async function getLikesFromWaline(path) {
		try {
			console.log('getLikesFromWaline 被调用, path:', path);
			if (!WALINE_SERVER_URL) {
				console.warn('WALINE_SERVER_URL 未配置，使用本地存储');
				return null;
			}

			const url = `${WALINE_SERVER_URL}/article?path=${encodeURIComponent(path)}&type=reaction0`;
			console.log('请求 URL:', url);
			const response = await fetch(url);
			console.log('响应状态:', response.status);
			if (!response.ok) {
				const text = await response.text();
				console.error('响应内容:', text);
				throw new Error('Waline 请求失败');
			}
			let data = await response.json();
			console.log('响应数据:', data, '类型:', typeof data);
			
			// 如果有 data 字段，先取出来
			if (data && data.data) {
				data = data.data;
				console.log('取到 data 字段后:', data);
			}
			// 处理可能的响应格式
			// 格式 1: 直接返回数字
			if (typeof data === 'number') {
				return data;
			}
			// 格式 2: 字符串数字
			if (typeof data === 'string' && !isNaN(parseInt(data))) {
				return parseInt(data);
			}
			// 格式 3: 数组
			if (Array.isArray(data) && data.length > 0) {
				if (typeof data[0].reaction0 === 'number') {
					return data[0].reaction0;
				}
				if (typeof data[0] === 'number') {
					return data[0];
				}
			}
			// 格式 4: 对象
			if (typeof data === 'object' && data !== null) {
				for (const key in data) {
					if (typeof data[key].reaction0 === 'number') {
						return data[key].reaction0;
					}
					if (typeof data[key] === 'number') {
						return data[key];
					}
				}
			}
			return 0;
		} catch (error) {
			console.error('获取 Waline 点赞数据失败:', error);
			return null;
		}
	}

	// 提交点赞到 Waline
	async function submitLikeToWaline(path, liked) {
		try {
			console.log('submitLikeToWaline 被调用, path:', path, 'liked:', liked);
			if (!WALINE_SERVER_URL) {
				console.warn('WALINE_SERVER_URL 未配置');
				return null;
			}

			const url = `${WALINE_SERVER_URL}/article`;
			const payload = JSON.stringify({
				path: path,
				type: 'reaction0',
				action: liked ? 'inc' : 'desc'
			});
			console.log('提交数据:', payload);
			const response = await fetch(url, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: payload
			});

			console.log('响应状态:', response.status);
			if (!response.ok) {
				const text = await response.text();
				console.error('响应内容:', text);
				throw new Error('Waline 请求失败');
			}
			
			let data = await response.json();
			console.log('响应数据:', data, '类型:', typeof data);
			
			// 如果有 data 字段，先取出来
			if (data && data.data) {
				data = data.data;
				console.log('取到 data 字段后:', data);
			}
			// 处理可能的响应格式
			// 格式 1: 直接返回数字
			if (typeof data === 'number') {
				return data;
			}
			// 格式 2: 字符串数字
			if (typeof data === 'string' && !isNaN(parseInt(data))) {
				return parseInt(data);
			}
			// 格式 3: 数组
			if (Array.isArray(data) && data.length > 0) {
				if (typeof data[0].reaction0 === 'number') {
					return data[0].reaction0;
				}
				if (typeof data[0] === 'number') {
					return data[0];
				}
			}
			// 格式 4: 对象
			if (typeof data === 'object' && data !== null) {
				for (const key in data) {
					if (typeof data[key].reaction0 === 'number') {
						return data[key].reaction0;
					}
					if (typeof data[key] === 'number') {
						return data[key];
					}
				}
			}
			return null;
		} catch (error) {
			console.error('提交 Waline 点赞失败:', error);
			return null;
		}
	}

	// 内存缓存，避免重复请求
const likeCache = new Map();
let pendingRequests = new Map();

// 带缓存的 Waline 请求
async function getLikesFromWalineWithCache(path) {
	if (likeCache.has(path)) {
		return likeCache.get(path);
	}
	
	if (pendingRequests.has(path)) {
		return pendingRequests.get(path);
	}
	
	const promise = getLikesFromWaline(path);
	pendingRequests.set(path, promise);
	
	try {
		const result = await promise;
		likeCache.set(path, result);
		return result;
	} finally {
		pendingRequests.delete(path);
	}
}

// 初始化所有点赞按钮（优化：并行请求）
async function initAllLikes() {
	console.log('initAllLikes 被调用');
	const buttons = document.querySelectorAll('.like-btn');
	console.log('找到的点赞按钮数量:', buttons.length);
	
	if (buttons.length === 0) return;
	
	// ⚡ 并行请求所有点赞数据
	const promises = Array.from(buttons).map(async (btn) => {
		const momentId = parseInt(btn.dataset.momentId);
		const diaryId = getDiaryId(momentId);
		const liked = hasLiked(momentId);
		const likeUrl = getLikeUrl(momentId);
		
		let count = 0;
		const walineCount = await getLikesFromWalineWithCache(likeUrl);
		if (walineCount !== null) {
			count = walineCount;
			localStorage.setItem(`diary_count_${diaryId}`, count.toString());
		} else {
			const savedCount = localStorage.getItem(`diary_count_${diaryId}`);
			if (savedCount) count = parseInt(savedCount);
		}
		
		return { btn, liked, count };
	});
	
	// 等待所有请求完成
	const results = await Promise.all(promises);
	
	// 批量更新显示
	results.forEach(({ btn, liked, count }) => {
		updateButtonDisplay(btn, liked, count);
	});
	console.log('initAllLikes 完成');
}

	// 处理点赞点击
	async function handleLikeClick(btn) {
		// 防止快速点击
		if (btn.disabled) return;
		console.log('handleLikeClick 被调用');
		
		// 记录开始时间，用于计算最小冷却时间
		const startTime = Date.now();
		const MIN_COOLDOWN_MS = 50; // 最小冷却时间缩短到 50ms
		
		const momentId = parseInt(btn.dataset.momentId);
		console.log('momentId:', momentId);
		const diaryId = getDiaryId(momentId);
		const wasLiked = hasLiked(momentId);
		console.log('wasLiked:', wasLiked);
		const countEl = btn.querySelector('.like-count');
		let currentCount = countEl ? parseInt(countEl.textContent) : 0;
		console.log('currentCount:', currentCount);
		const likeUrl = getLikeUrl(momentId);
		
		// 立即禁用按钮，防止重复点击
		btn.disabled = true;
		
		// 切换点赞状态
		const newLiked = !wasLiked;
		console.log('newLiked:', newLiked);
		
		if (newLiked) {
			// 点赞
			setLiked(momentId, true);
			currentCount = currentCount + 1;
			
			// 添加心跳动画
			btn.style.transform = 'scale(1.15)';
			setTimeout(() => {
				btn.style.transform = 'scale(1)';
			}, 200);
		} else {
			// 取消点赞
			setLiked(momentId, false);
			currentCount = Math.max(0, currentCount - 1);
		}
		
		// 保存点赞数到本地（作为降级方案）
		localStorage.setItem(`diary_count_${diaryId}`, currentCount.toString());
		
		// 更新显示（先本地更新，给用户即时反馈）
		updateButtonDisplay(btn, newLiked, currentCount);
		
		// 异步提交到 Waline
		console.log('开始提交到 Waline');
		const walineCount = await submitLikeToWaline(likeUrl, newLiked);
		console.log('Waline 返回:', walineCount);
		
		// 修复数字抽搐问题：只有当 Waline 返回的数值和本地预期相差较大时才更新
		// 本地预期：点赞+1，取消-1
		if (walineCount !== null) {
			// 只在合理范围内更新，避免数字异常
			if (typeof walineCount === 'number' && walineCount >= 0) {
				// 检查变化是否合理
				const diff = Math.abs(walineCount - currentCount);
				if (diff <= 1) {
					// 合理的变化，更新显示
					updateButtonDisplay(btn, newLiked, walineCount);
					localStorage.setItem(`diary_count_${diaryId}`, walineCount.toString());
				} else {
					console.warn('Waline 返回数值异常，使用本地数值:', walineCount, '预期附近:', currentCount);
				}
			}
		}
		
		// 确保最小冷却时间
		const elapsedTime = Date.now() - startTime;
		if (elapsedTime < MIN_COOLDOWN_MS) {
			// 如果请求太快，等待剩余时间
			await new Promise(resolve => setTimeout(resolve, MIN_COOLDOWN_MS - elapsedTime));
		}
		
		// 恢复按钮可用
		btn.disabled = false;
	}

	// 点击事件委托
	document.addEventListener('click', function(e) {
		const btn = e.target.closest('.like-btn');
		if (btn) {
			handleLikeClick(btn);
		}
	});

	// 初始化 Waline SDK（WebSocket 实时推送）
	async function initWalineSocket() {
		if (!WALINE_SERVER_URL) {
			console.warn('WALINE_SERVER_URL 未配置，跳过 WebSocket 初始化');
			return;
		}

		try {
			// 动态加载 Waline SDK
			const { Waline } = await import('@waline/client');
			
			// 创建 Waline 实例
			walineInstance = Waline({
				el: document.createElement('div'), // 不需要渲染评论区
				serverURL: WALINE_SERVER_URL,
				path: '/diary',
				socket: true, // ⚡ 启用 WebSocket 实时推送
				reaction: ['👍'], // 启用点赞功能
			});

			// 🚀 监听点赞事件（实时推送）
			walineInstance.on('reaction', (data) => {
				console.log('❤️ 收到实时点赞更新:', data);
				
				// 解析日记 ID
				if (data.path && data.path.startsWith('/diary/diary_')) {
					const momentId = parseInt(data.path.replace('/diary/diary_', ''));
					const btn = document.querySelector(`.like-btn[data-moment-id="${momentId}"]`);
					
					if (btn) {
						const liked = hasLiked(momentId);
						updateButtonDisplay(btn, liked, data.count);
						
						// 同步到本地存储
						const diaryId = getDiaryId(momentId);
						localStorage.setItem(`diary_count_${diaryId}`, data.count.toString());
					}
				}
			});

			console.log('✅ Waline WebSocket 连接成功');
		} catch (error) {
			console.error('❌ Waline SDK 初始化失败:', error);
		}
	}

	// 页面加载完成后初始化
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			initAllLikes();
			initWalineSocket();
		});
	} else {
		initAllLikes();
		initWalineSocket();
	}

	// 延迟再执行一次，确保 Astro 组件加载完
	setTimeout(initAllLikes, 50);
	setTimeout(initAllLikes, 200);

	// 页面卸载时清理资源
	document.addEventListener('beforeunload', () => {
		if (walineInstance) {
			try {
				walineInstance.destroy();
				console.log('✅ Waline 实例已销毁');
			} catch (error) {
				console.error('❌ 销毁 Waline 实例失败:', error);
			}
		}
	});
</script>
