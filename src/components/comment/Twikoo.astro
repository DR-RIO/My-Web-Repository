---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="twikoo-container" class="twikoo-container">
	<div id="tcomment"></div>
</div>

<script is:inline define:vars={{ config }}>
	(function () {
		const TWIKOO_CONTAINER_ID = "twikoo-container";
		const SCROLL_PROTECTION_URL = "/scroll-protection.js";
		// 国内CDN列表，按速度和可靠性排序
		const TWIKOO_CDN_URLS = [
			"https://unpkg.com/twikoo@1.7.7/dist/twikoo.all.min.js", // unpkg
			"https://cdn.bootcdn.net/ajax/libs/twikoo/1.7.7/twikoo.all.min.js", // BootCDN
			"https://cdn.jsdelivr.net/npm/twikoo@1.7.7/dist/twikoo.all.min.js" // jsdelivr 作为备用
		];
		const ROOT_MARGIN = "200px";

		let observer = null;
		let twikooLoaded = false;

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		function createTwikooConfig() {
			return {
				...config,
				path: getCurrentPath(),
				el: "#tcomment",
			};
		}

		async function loadScrollProtection() {
			return new Promise((resolve, reject) => {
				if (document.getElementById("scroll-protection-loaded")) {
					resolve();
					return;
				}
				const script = document.createElement("script");
				script.src = SCROLL_PROTECTION_URL;
				script.onload = () => {
					const marker = document.createElement("div");
					marker.id = "scroll-protection-loaded";
					document.body.appendChild(marker);
					resolve();
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		async function loadTwikooScript() {
			if (
				twikooLoaded ||
				document.getElementById("twikoo-script-loaded")
			) {
				return;
			}
			await loadScrollProtection();
			return new Promise((resolve, reject) => {
				let currentCdnIndex = 0;

				function tryNextCdn() {
					if (currentCdnIndex >= TWIKOO_CDN_URLS.length) {
						reject(new Error("All CDN URLs failed to load"));
						return;
					}

					const cdnUrl = TWIKOO_CDN_URLS[currentCdnIndex];
					currentCdnIndex++;

					console.log(`Trying to load Twikoo from CDN: ${cdnUrl}`);

					const script = document.createElement("script");
					script.id = "twikoo-script-loaded";
					script.src = cdnUrl;
					script.onload = () => {
						twikooLoaded = true;
						console.log(`Twikoo loaded successfully from CDN: ${cdnUrl}`);
						resolve();
					};
					script.onerror = () => {
						console.warn(`Failed to load Twikoo from CDN: ${cdnUrl}`);
						// Remove the failed script
						if (script.parentNode) {
							script.parentNode.removeChild(script);
						}
						// Try next CDN
						tryNextCdn();
					};
					document.head.appendChild(script);
				}

				// Start trying CDNs
				tryNextCdn();
			});
		}

		async function initTwikoo() {
			const commentEl = document.getElementById("tcomment");
			if (!commentEl) {
				return;
			}

			try {
				await loadTwikooScript();

				if (typeof twikoo === "undefined") {
					console.warn("[Twikoo] 脚本加载失败");
					return;
				}

				commentEl.innerHTML = "";
				const dynamicConfig = createTwikooConfig();
				await twikoo.init(dynamicConfig);
			} catch (error) {
				console.error("[Twikoo] 初始化失败:", error);
			}
		}

		function cleanup() {
			if (observer) {
				observer.disconnect();
				observer = null;
			}
			if (window.swup?.hooks) {
				window.swup.hooks.off("content:replace", initTwikoo);
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(TWIKOO_CONTAINER_ID);
			if (!container) {
				return;
			}

			observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						observer.disconnect();
						observer = null;
						initTwikoo();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			observer.observe(container);
		}

		function setupSwupHooks() {
			if (window.swup?.hooks) {
				window.swup.hooks.on("content:replace", () => {
					setTimeout(setupLazyLoad, 200);
				});
			} else {
				document.addEventListener(
					"swup:enable",
					() => {
						if (window.swup?.hooks) {
							window.swup.hooks.on("content:replace", () => {
								setTimeout(setupLazyLoad, 200);
							});
						}
					},
					{ once: true },
				);
			}
		}

		document.addEventListener("mizuki:page:loaded", () => {
			setupLazyLoad();
		});

		window.addEventListener("beforeunload", cleanup);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}
	})();
</script>

<style>
	.twikoo-container {
		min-height: 200px;
	}
</style>
